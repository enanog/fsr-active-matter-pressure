# ---------------------------------------------------------------------------
# Altium Designer: carpetas generadas y temporales
# ---------------------------------------------------------------------------
**/History/
**/__Previews/
**/Project Logs*/
**/Project Outputs*/
*.PcbDocPreview
*.SchDocPreview
*.CompileLog
*.htm
*.SchDoc.Zip

# ---------------------------------------------------------------------------
# Datos de video: los videos (0,6 a 4 GB) superan el límite de GitHub (100 MB por
# archivo) y se transfieren por pendrive; de sus carpetas solo se versiona .gitkeep.
# Sí se versionan las sesiones de análisis (sesiones/*.npz) y las trayectorias
# exportadas (trayectorias/*.csv), todas por debajo de 100 MB.
# ---------------------------------------------------------------------------
datos/video/originales/*
datos/video/recortados/*
datos/video/seguimiento/*
!datos/video/*/.gitkeep
datos/video/**/*.[mM][pP]4
Videos/

# ---------------------------------------------------------------------------
# LaTeX: archivos intermedios (los PDF finales sí se versionan)
# ---------------------------------------------------------------------------
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.bak_*
.*.tmp

# ---------------------------------------------------------------------------
# Python y LTspice
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
*.raw
*.op.raw
